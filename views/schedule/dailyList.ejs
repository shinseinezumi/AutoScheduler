<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title><%= date %> の予定一覧</title>
<style>
body { font-family:"Segoe UI","Meiryo"; background:#f5f6f7; margin:0; padding:0; color:#333; }
header { background:#1e2a38; color:white; text-align:center; padding:15px 0; font-size:1.3em; font-weight:bold; }
main { max-width:600px; margin:30px auto; background:white; border-radius:12px; box-shadow:0 4px 10px rgba(0,0,0,0.1); padding:20px; }
.event-item { border:1px solid #ccc; border-radius:8px; padding:10px; margin-bottom:15px; background:#fafafa; cursor:pointer; }
.event-item:hover { background:#eef4ff; }
button { padding:8px 15px; border:none; border-radius:6px; cursor:pointer; font-size:14px; margin-top:10px; }
.back-btn { background:#ccc; }
.edit-btn { background:#3498db; color:white; }
.add-btn { background:#2ecc71; color:white; }
</style>
</head>
<body>

<header><%= date %> の予定一覧</header>
<main>
<% if(dayEvents.length === 0) { %>
  <p>この日の予定はありません。</p>
  <a href="/schedule/form?date=<%= date %>"><button class="add-btn">予定を追加</button></a>
<% } else { %>
  <% dayEvents.forEach(function(e) { %>
    <div class="event-item">
      <strong><%= e.title %></strong><br>
      <%= e.start_datetime.replace('T',' ') %> ～ <%= e.end_datetime.replace('T',' ') %><br>
      <%= e.memo %><br>
      <a href="/schedule/detail/<%= e.id %>"><button class="edit-btn">編集</button></a>
    </div>
  <% }); %>
  <a href="/schedule/form?date=<%= date %>"><button class="add-btn">予定を追加</button></a>
<% } %>

<button class="back-btn" onclick="location.href='/schedule/calendar'">戻る</button>
</main>

</body>
</html>