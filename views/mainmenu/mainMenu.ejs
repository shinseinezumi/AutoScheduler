<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>メインメニュー</title>
        <style>
            body {
            margin: 0;
            font-family: "Segoe UI", "ヒラギノ角ゴ ProN", Meiryo, sans-serif;
            display: flex;
            height: 100vh;
            background-color: #f8f8f8;
            }

            /* サイドメニュー */
            .sidebar {
            width: 220px;
            background-color: #efe8f5;
            border-right: 1px solid #d2c7e0;
            display: flex;
            flex-direction: column;
            padding: 0;
            }

            .sidebar-header {
            background-color: #d9cdee;
            font-weight: bold;
            padding: 16px;
            text-align: center;
            border-bottom: 1px solid #c8bce0;
            }

            .menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
            }

            .menu li {
            padding: 14px 20px;
            cursor: pointer;
            border-bottom: 1px solid #e0d8ef;
            transition: background-color 0.2s;
            }

            .menu li:hover {
            background-color: #e5daf8;
            }

            .menu li.active {
            background-color: #cdb8f5;
            font-weight: bold;
            }

            /* メインコンテンツ */
            .main-content {
            flex-grow: 1;
            padding: 20px;
            background-color: #fff;
            }

            h1 {
            margin-top: 0;
            color: #4a3474;
            }
        </style>
    </head>
    <body>
        <div class="sidebar">
            <ul class="menu">
                <li id="schedule">スケジュール</li>
                <li id="task">タスク管理</li>
                <li id="mypage">マイページ</li>
                <li id="mail">メール</li>
                <li id="members">メンバー紹介</li>
                <li id="logout">ログアウト</li>
            </ul>
        </div>
        <div class="main-content" id="content-area">
            <h1>メインメニュー</h1>
            <p>アカウント名：<%= user.name %></p>
        </div>
    </body>

    <script src="/public/js/mainMenu/mainMenu.js"></script>

</html>