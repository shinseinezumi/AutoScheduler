<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>パスワードを変更する</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css">
<style>
  body{ margin:0; background:#f5f6f7; font-family:system-ui,"Noto Sans JP"; display:flex; justify-content:center; align-items:center; height:100vh; }
  .card{ width:100%; max-width:420px; background:white; padding:24px; border-radius:12px; box-shadow:0 4px 14px rgba(0,0,0,0.1); }
  h1{font-size:20px; margin-top:0;}
  .form-row{margin-bottom:16px;}
  label{display:block; font-weight:600; margin-bottom:8px;}
  .input-wrap{position:relative;}
  input[type=password], input[type=text]{ width:100%; padding:12px; border-radius:8px; border:1px solid #ccc; box-sizing:border-box; }
  .toggle-eye{ position:absolute; right:10px; top:50%; transform:translateY(-50%); background:transparent; border:none; cursor:pointer; font-size:18px; color:#888; }
  .toggle-eye:hover{ color:#333; }
  .btn{ width:100%; padding:12px; background:#4ba3d8; color:white; font-weight:bold; border:none; border-radius:8px; cursor:pointer; }
  .msg{margin-top:12px; padding:10px; border-radius:8px;}
  .msg-success{background:#e7f8ef; color:#2a8a52; border:1px solid #bde5d0;}
  .msg-error{background:#fdecea; color:#c00; border:1px solid #f5c6c3;}
</style>
</head>
<body>
<div class="card">
  <h1>パスワードを変更する</h1>

  <form id="form">
    <div class="form-row">
      <label for="current">現在のパスワード</label>
      <div class="input-wrap">
        <input id="current" type="password" required />
        <button type="button" class="toggle-eye" data-target="current"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>

    <div class="form-row">
      <label for="newpw">新しいパスワード</label>
      <div class="input-wrap">
        <input id="newpw" type="password" required />
        <button type="button" class="toggle-eye" data-target="newpw"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>

    <div class="form-row">
      <label for="confirm">新しいパスワード（確認）</label>
      <div class="input-wrap">
        <input id="confirm" type="password" required />
        <button type="button" class="toggle-eye" data-target="confirm"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>

    <button class="btn" type="submit">パスワードを変更する</button>

    <div id="msgArea"></div>
    <button type="button" class="btn back-btn" onclick="location.href='/mypage'" 
    style="margin-top:10px; background:#78a3c1; color:#333;">
    戻る
    </button>
  </form>
</div>

<script>
  document.querySelectorAll('.toggle-eye').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const target = document.getElementById(btn.dataset.target);
      const icon = btn.querySelector('i');
      if(target.type === 'password'){
        target.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        target.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    });
  });

  const form = document.getElementById('form');
  const msgArea = document.getElementById('msgArea');

  function showMsg(text, type){
    msgArea.innerHTML = `<div class="msg msg-${type}">${text}</div>`;
  }

  form.addEventListener('submit', async e=>{
    e.preventDefault();
    msgArea.innerHTML = '';

    const currentPw = document.getElementById('current').value;
    const newPw = document.getElementById('newpw').value;
    const confirmPw = document.getElementById('confirm').value;

    if(newPw !== confirmPw){
      showMsg("確認用パスワードが一致しません。", "error");
      return;
    }

    try {
      const res = await fetch("/changepassword/changepassword", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ current: currentPw, newpw: newPw })
      });
      const result = await res.json();

      if(result.ok){
        showMsg("パスワードを変更しました。", "success");
        form.reset();

        // 1秒後に自動でリダイレクト
        setTimeout(() => {
        window.location.href = result.redirect || "/mypage";
        }, 1000);
      } else {
        showMsg(result.message, "error");
      }
    } catch(err){
      showMsg("サーバーエラーが発生しました。", "error");
      console.error(err);
    }
  });
</script>

</body>
</html>